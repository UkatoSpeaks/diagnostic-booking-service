DATABASE_URL=postgresql://postgres:postgres@localhost:5432/diagnostic_booking
SECRET_KEY=replace-with-a-long-random-string-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Shared secret used to sign payment webhooks (HMAC-SHA256 of the raw body)
WEBHOOK_SECRET=replace-with-another-long-random-string

# Comma-separated emails that become admins when they sign up
ADMIN_EMAILS=admin@example.com

# Probability (0-1) that a mock payment without an explicit outcome succeeds
MOCK_PAYMENT_SUCCESS_RATE=0.8
